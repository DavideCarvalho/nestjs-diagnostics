{
  "name": "nestjs-diagnostics",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "A standard convention for @dudousxd/nestjs-* libs to emit observability events over node:diagnostics_channel — recorded by a single generic Telescope watcher.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-diagnostics.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && biome check --write .",
    "release": "pnpm --filter './packages/*' build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@swc/core": "1.16.2",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
